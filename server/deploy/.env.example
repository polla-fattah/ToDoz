# Copy to .env (deploy.sh does this for you). Every line is optional except the domain in public mode.

# Public mode only: the DNS name that points at this machine.
TASKFLOW_DOMAIN=sync.example.com

# The address people type into the app. Needed only for "Connect Google Calendar" (Google sends the
# person back here). In public mode this is https://<TASKFLOW_DOMAIN>.
TASKFLOW_PUBLIC_URL=

# Google Calendar connection (leave empty to switch it off). Steps are in DEPLOY.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
