http://{$TASKFLOW_DOMAIN}, https://{$TASKFLOW_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Downloads: direct static file serving with attachment header
	handle /downloads/* {
		root * /var/www/landing
		header Content-Disposition "attachment"
		file_server
	}

	# Attachment blobs (large payloads up to 110MB)
	handle /v1/blobs/* {
		request_body {
			max_size 110MB
		}
		reverse_proxy taskflow:8080
	}

	# Backend API, web app, and webhooks
	handle /app* {
		reverse_proxy taskflow:8080 {
			header_down Content-Security-Policy "default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		}
	}

	handle /v1/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy taskflow:8080
	}

	handle /web/* {
		reverse_proxy taskflow:8080 {
			header_down Content-Security-Policy "default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		}
	}

	# The REST API: the web app at /app and your own scripts use it. Without this the landing page answers it
	# (a GET gets the landing page back and a POST gets "405 Method Not Allowed").
	handle /api/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy taskflow:8080
	}

	# Incoming webhooks (/hooks/in/<id>)
	handle /hooks/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy taskflow:8080
	}

	handle /ical/* {
		reverse_proxy taskflow:8080
	}

	handle /google/* {
		reverse_proxy taskflow:8080
	}

	handle /health {
		reverse_proxy taskflow:8080
	}

	# Static landing page for root and website assets (CSS, JS, images)
	handle {
		root * /var/www/landing
		file_server
		try_files {path} /index.html
	}
}
