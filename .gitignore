# Signing keys, certificates and secrets: never commit
*.p12
*.jks
*.keystore
*.key
*.pem
*.crt
*.cert
key.properties
.env
.env.*
!.env.example

# Build output and binaries
build/
*.apk
*.aab
*.msi
*.msix
*.deb
*.rpm
*.exe
*.dll
*.so
*.dylib
.dart_tool/
.gradle/
local.properties
.idea/
*.iml
*.vscode/

# Flutter generated
.flutter-plugins
.flutter-plugins-dependencies
.packages

# Server deployment: local state, databases and backups
server/deploy/.mode
server/deploy/backups/
server/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
