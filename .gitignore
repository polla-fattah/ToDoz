# Archives & temporary artifacts
*.tar
*.tar.gz
*.zip
*.7z
*.cab
*.tmp
*.bak

# Web client: dependencies and build output (the build is embedded in server/lib/web_assets.dart)
server/web/node_modules/
server/web/dist/

# Landing page binary downloads
landing/downloads/*.msi
landing/downloads/*.msix
landing/downloads/*.apk
landing/downloads/*.deb

# OS and Editor metadata
.DS_Store
Thumbs.db
desktop.ini

# Local secrets (server login). Never commit.
.secrets/
